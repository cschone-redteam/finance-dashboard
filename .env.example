# Copy to .env.local and fill in.

# Google sign-in (NextAuth v5). Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
# Optional locally; set to the deployed origin in production if trustHost is not enough.
# AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local page iteration without Google sign-in (development builds only).
# Put this in .env.development.local, never in a Vercel environment.
# DEV_AUTH_BYPASS=1

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=
QUICKBOOKS_REDIRECT_URI=
HUBSPOT_ACCESS_TOKEN=
CHARGEBEE_API_KEY=
